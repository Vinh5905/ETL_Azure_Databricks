id-github-ci" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontColor=#232F3E;image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="325" y="740" width="52" height="52" as="geometry"/></mxCell><mxCell id="d3_c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d3_c33" target="d3_c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3_c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d3_c34" target="d3_c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3_c38" value="Subject phải khớp: …:ref:refs/heads/main · …:pull_request · …:environment:prod · …:environment:stream&lt;br&gt;→ token Azure (Terraform) và Databricks (auth azure-cli)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="345" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
