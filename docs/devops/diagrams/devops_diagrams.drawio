Space=wrap;html=1;fontSize=12;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=#545B64;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1660" y="140" width="165" height="50" as="geometry"/></mxCell><mxCell id="d2_c13" value="dbx_workspace" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=#545B64;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1840" y="140" width="165" height="50" as="geometry"/></mxCell><mxCell id="d2_c14" value="Sub A · core (P1 giữ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0078D4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=46;spacingTop=9;spacingBottom=12;fontSize=16;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1180" height="540" as="geometry"/></mxCell><mxCell id="d2_c15" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="48" y="246" width="30" height="30" as="geometry"/></mxCell><mxCell id="d2_c16" value="Sub B · stream (P3 giữ) · region khác" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0078D4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=46;spacingTop=9;spacingBottom=12;fontSize=16;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1250" y="240" width="370" height="330" as="geometry"/></mxCell><mxCell id="d2_c17" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="1258" y="246" width="30" height="30" as="geometry"/></mxCell><mxCell id="d2_c18" value="Sub C / D · sandbox (P4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0078D4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=46;spacingTop=9;spacingBottom=12;fontSize=16;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1650" y="240" width="390" height="330" as="geometry"/></mxCell><mxCell id="d2_c19" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="1658" y="246" width="30" height="30" as="geometry"/></mxCell><mxCell id="d2_c20" value="&lt;b&gt;bootstrap&lt;/b&gt;&lt;br&gt;&lt;font color='#545B64'&gt;state: local → bootstrap.tfstate · chạy 1 lần&lt;/font&gt;&lt;br&gt;&lt;br&gt;• rg-tfstate (khóa CanNotDelete)&lt;br&gt;• storage sttfstate…&lt;br&gt;&amp;nbsp;&amp;nbsp;versioning · soft delete · tắt shared key&lt;br&gt;• UAMI id-github-ci&lt;br&gt;&amp;nbsp;&amp;nbsp;+ federated credential (main · PR · env)&lt;br&gt;• RBAC: 4 thành viên + CI vào state" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B42BC;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="360" height="190" as="geometry"/></mxCell><mxCell id="d2_c21" value="&lt;b&gt;container tfstate&lt;/b&gt;&lt;br&gt;&lt;br&gt;bootstrap.tfstate&lt;br&gt;core.tfstate&lt;br&gt;databricks.tfstate&lt;br&gt;orchestration.tfstate&lt;br&gt;stream.tfstate&lt;br&gt;sandbox-&amp;lt;member&amp;gt;.tfstate&lt;br&gt;&lt;br&gt;&lt;font color='#545B64'&gt;khóa bằng blob lease&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="520" width="360" height="200" as="geometry"/></mxCell><mxCell id="d2_c22" value="" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontColor=#232F3E;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="370" y="530" width="48" height="48" as="geometry"/></mxCell><mxCell id="d2_c23" value="&lt;b&gt;10-core&lt;/b&gt;&lt;br&gt;&lt;font color='#545B64'&gt;state: core.tfstate&lt;/font&gt;&lt;br&gt;&lt;br&gt;3.1 resource group · tags&lt;br&gt;3.2 ADLS Gen2 (HNS) · 6 container&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ lifecycle landing → cool&lt;br&gt;3.3 Key Vault (RBAC)&lt;br&gt;3.4 Access Connector (MI)&lt;br&gt;3.5 Databricks workspace Premium&lt;br&gt;3.6 Azure SQL free offer · retail_db&lt;br&gt;3.7 Data Factory + MI&lt;br&gt;3.8 RBAC 4 thành viên&lt;br&gt;3.9 Budget 25/50/75/90 % + action group" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B42BC;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="480" y="300" width="340" height="260" as="geometry"/></mxCell><mxCell id="d2_c24" value="&lt;b&gt;30-databricks&lt;/b&gt;&lt;br&gt;&lt;font color='#545B64'&gt;state: databricks.tfstate · provider databricks&lt;br&gt;đọc từ 10-core: workspace_url, access_connector_id&lt;/font&gt;&lt;br&gt;&lt;br&gt;• storage credential · external location&lt;br&gt;• catalog instacart · 7 schema · volume&lt;br&gt;• SP cho CI · user / nhóm · grants&lt;br&gt;• cluster policy single-node&lt;br&gt;• secret scope kv (P1 apply)&lt;br&gt;• SQL warehouse serverless" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF3621;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="300" height="240" as="geometry"/></mxCell><mxCell id="d2_c25" value="&lt;b&gt;40-orchestration&lt;/b&gt;&lt;br&gt;&lt;font color='#545B64'&gt;state: orchestration.tfstate&lt;/font&gt;&lt;br&gt;&lt;br&gt;• ADF linked service · dataset&lt;br&gt;• pipeline (activities_json từ adf/)&lt;br&gt;• schedule trigger" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B42BC;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="900" y="620" width="300" height="130" as="geometry"/></mxCell><mxCell id="d2_c26" value="&lt;b&gt;20-stream&lt;/b&gt;&lt;br&gt;&lt;font color='#545B64'&gt;state: stream.tfstate&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Event Hubs Standard 1 TU&lt;br&gt;• hub orders-stream · 2 partition&lt;br&gt;• consumer group dbx-bronze&lt;br&gt;• SAS send / listen tách riêng&lt;br&gt;• secret eh-* → Key Vault Sub A&lt;br&gt;&amp;nbsp;&amp;nbsp;(provider alias core)&lt;br&gt;&lt;br&gt;&lt;i&gt;bật/tắt theo buổi: stream-toggle&lt;/i&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3999C6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1275" y="300" width="320" height="240" as="geometry"/></mxCell><mxCell id="d2_c27" value="&lt;b&gt;90-sandbox&lt;/b&gt;&lt;br&gt;&lt;font color='#545B64'&gt;state: sandbox-&amp;lt;member&amp;gt;.tfstate&lt;/font&gt;&lt;br&gt;&lt;br&gt;• module dbx_workspace&lt;br&gt;&amp;nbsp;&amp;nbsp;workspace #2 + access connector&lt;br&gt;• storage nhỏ&lt;br&gt;• cùng metastore nếu cùng region&lt;br&gt;&lt;br&gt;&lt;i&gt;chỉ dựng khi tới G3&lt;/i&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0194E2;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1675" y="300" width="340" height="210" as="geometry"/></mxCell><mxCell id="d2_c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7B42BC;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.25;" edge="1" parent="1" source="d2_c20" target="d2_c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2_c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#FF3621;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="d2_c23" target="d2_c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2_c30" value="sau bundle deploy:&lt;br&gt;job ID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7B42BC;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d2_c24" target="d2_c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2_c31" value="key_vault_id (remote state)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3999C6;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="d2_c23" target="d2_c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="277"/><mxPoint x="1435" y="277"/></Array></mxGeometry></mxCell><mxCell id="d2_c32" value="0" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="52" y="282" width="34" height="34" as="geometry"/></mxCell><mxCell id="d2_c33" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="462" y="282" width="34" height="34" as="geometry"/></mxCell><mxCell id="d2_c34" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="882" y="282" width="34" height="34" as="geometry"/></mxCell><mxCell id="d2_c35" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1257" y="282" width="34" height="34" as="geometry"/></mxCell><mxCell id="d2_c36" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="882" y="602" width="34" height="34" as="geometry"/></mxCell><mxCell id="d2_c37" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1657" y="282" width="34" height="34" as="geometry"/></mxCell><mxCell id="d2_c38" value="&lt;b&gt;Thứ tự apply&lt;/b&gt;&lt;br&gt;0 bootstrap (P1, local, một lần)&lt;br&gt;1 10-core → 2 30-databricks → 3 20-stream&lt;br&gt;4 40-orchestration (sau lần bundle deploy prod đầu tiên)&lt;br&gt;5 90-sandbox (P4, khi tới G3)&lt;br&gt;&lt;br&gt;&lt;b&gt;Destroy&lt;/b&gt; đi ngược lại: 40 → 30 → 10.&lt;br&gt;20-stream destroy mỗi đêm, không ảnh hưởng stack khác." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="480" y="610" width="400" height="200" as="geometry"/></mxCell><mxCell id="d2_c39" value="&lt;b&gt;Vì sao tách stack&lt;/b&gt;&lt;br&gt;• khác subscription / người giữ quyền&lt;br&gt;• khác vòng đời (stream bật/tắt hằng ngày)&lt;br&gt;• provider databricks cần workspace đã tồn tại&lt;br&gt;• lỗi ở pipeline ADF không chạm tới workspace" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1270" y="610" width="760" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d3" name="Luồng CI/CD"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="960" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d3_c1" value="Luồng CI/CD với GitHub Actions: PR → kiểm tra → review → merge → apply / deploy" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2040" height="34" as="geometry"/></mxCell><mxCell id="d3_c2" value="Không lưu secret dài hạn: job cần Azure/Databricks đăng nhập bằng OIDC → federated credential → UAMI id-github-ci." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#545B64;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2040" height="24" as="geometry"/></mxCell><mxCell id="d3_c3" value="Thành viên&lt;br&gt;nhánh feat/*&lt;br&gt;&lt;font color='#545B64'&gt;pre-commit: fmt · tflint&lt;br&gt;ruff · gitleaks&lt;/font&gt;" style="shape=image;aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=13;fontColor=#232F3E;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="90" y="300" width="64" height="64" as="geometry"/></mxCell><mxCell id="d3_c4" value="Pull Request&lt;br&gt;→ main" style="shape=image;aspect=fixed;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=13;fontColor=#232F3E;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="64" height="64" as="geometry"/></mxCell><mxCell id="d3_c5" value="Trên Pull Request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#24292F;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;spacingBottom=12;fontSize=16;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="540" height="530" as="geometry"/></mxCell><mxCell id="d3_c6" value="&lt;b&gt;pr-checks&lt;/b&gt; · mọi PR · không cần Azure&lt;br&gt;• terraform fmt · validate · tflint · trivy&lt;br&gt;• ruff · pytest (pyspark local)&lt;br&gt;• databricks bundle validate&lt;br&gt;• infracost diff → comment chi phí" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#24292F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="475" y="150" width="490" height="125" as="geometry"/></mxCell><mxCell id="d3_c7" value="&lt;b&gt;tf-plan&lt;/b&gt; · PR đụng infra/** · &lt;font color='#7B42BC'&gt;&lt;b&gt;OIDC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• matrix theo stack bị đổi&lt;br&gt;• terraform plan → comment lên PR" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B42BC;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="475" y="305" width="490" height="100" as="geometry"/></mxCell><mxCell id="d3_c8" value="&lt;b&gt;de-deploy (dev)&lt;/b&gt; · PR đụng src/** bundles/** · &lt;font color='#7B42BC'&gt;&lt;b&gt;OIDC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• bundle deploy -t dev → job [dev user]&lt;br&gt;• chạy smoke test trên dữ liệu mẫu&lt;br&gt;• đóng PR → bundle destroy -t dev" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF3621;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="475" y="435" width="490" height="120" as="geometry"/></mxCell><mxCell id="d3_c9" value="&lt;b&gt;Review + approve&lt;/b&gt;&lt;br&gt;CODEOWNERS&lt;br&gt;check xanh" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=#24292F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1020" y="270" width="190" height="150" as="geometry"/></mxCell><mxCell id="d3_c10" value="Sau merge vào main · environment prod (cần duyệt)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF8FE;strokeColor=#7B42BC;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;spacingBottom=12;fontSize=16;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1250" y="110" width="430" height="530" as="geometry"/></mxCell><mxCell id="d3_c11" value="&lt;b&gt;tf-apply&lt;/b&gt; · &lt;font color='#7B42BC'&gt;&lt;b&gt;OIDC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• chờ reviewer bấm Approve&lt;br&gt;• 10-core → 30-databricks → 40-orchestration&lt;br&gt;• chỉ apply khi plan có thay đổi" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B42BC;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1275" y="170" width="380" height="130" as="geometry"/></mxCell><mxCell id="d3_c12" value="&lt;b&gt;de-deploy (prod)&lt;/b&gt; · &lt;font color='#7B42BC'&gt;&lt;b&gt;OIDC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• bundle deploy -t prod&lt;br&gt;• job chạy bằng service principal&lt;br&gt;• lịch do ADF trigger gọi" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF3621;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1275" y="380" width="380" height="130" as="geometry"/></mxCell><mxCell id="d3_c13" value="Sub A&lt;br&gt;10-core · 30 · 40" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontColor=#232F3E;image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="1830" y="200" width="64" height="64" as="geometry"/></mxCell><mxCell id="d3_c14" value="Databricks workspace&lt;br&gt;job prod + job [dev]" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontColor=#232F3E;image=img/lib/azure2/analytics/Azure_Databricks.svg;" vertex="1" parent="1"><mxGeometry x="1830" y="410" width="64" height="64" as="geometry"/></mxCell><mxCell id="d3_c15" value="Sub B · Event Hubs" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontColor=#232F3E;image=img/lib/azure2/analytics/Event_Hubs.svg;" vertex="1" parent="1"><mxGeometry x="1830" y="740" width="64" height="64" as="geometry"/></mxCell><mxCell id="d3_c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#24292F;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d3_c3" target="d3_c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3_c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#24292F;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3_c4" target="d3_c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3_c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#24292F;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3_c4" target="d3_c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3_c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#24292F;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3_c4" target="d3_c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3_c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#24292F;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFF