try"/></mxCell><mxCell id="d2_c7" value="&lt;b&gt;L₁&lt;/b&gt; (collect về driver)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3EDFD;strokeColor=#7B3FE4;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="257" width="300" height="50" as="geometry"/></mxCell><mxCell id="d2_c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E25A1C;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2_c4" target="d2_c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2_c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E25A1C;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d2_c5" target="d2_c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2_c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7B3FE4;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d2_c6" target="d2_c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2_c11" value="Pha 2 · lặp theo k (chung)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=#7B3FE4;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="700" height="36" as="geometry"/></mxCell><mxCell id="d2_c12" value="&lt;b&gt;apriori_gen&lt;/b&gt; (driver): join tiền tố k−1&lt;br&gt;+ tỉa theo downward closure → &lt;b&gt;Cₖ₊₁&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3EDFD;strokeColor=#7B3FE4;strokeWidth=2;align=left;verticalAlign=