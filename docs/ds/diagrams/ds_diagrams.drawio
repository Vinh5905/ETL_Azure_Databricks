0.7;" edge="1" parent="1" source="d2_c7" target="d2_c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="340"/><mxPoint x="710" y="340"/><mxPoint x="710" y="219"/></Array></mxGeometry></mxCell><mxCell id="d2_c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7B3FE4;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2_c12" target="d2_c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2_c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E25A1C;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d2_c13" target="d2_c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2_c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E25A1C;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d2_c14" target="d2_c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2_c21" value="k ← k+1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7B3FE4;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;exitX=0;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="d2_c15" target="d2_c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="725" y="305"/><mxPoint x="725" y="191"/></Array></mxGeometry></mxCell><mxCell id="d2_c22" value="Khác nhau: dữ liệu được cache qua từng bậc" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=#545B64;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1400" height="36" as="geometry"/></mxCell><mxCell id="d2_c23" value="&lt;b&gt;DApriori&lt;/b&gt;&lt;br&gt;• cache &lt;b&gt;tx gốc&lt;/b&gt; một lần, mỗi bậc quét lại toàn bộ&lt;br&gt;• lọc item theo ứng viên chỉ diễn ra trong flatMap, không lưu lại&lt;br&gt;• đơn giản, đúng mô tả mục 3.2 của bài báo" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEEE6;strokeColor=#E25A1C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="680" height="120" as="geometry"/></mxCell><mxCell id="d2_c24" value="&lt;b&gt;DATID&lt;/b&gt; (Apriori-TID)&lt;br&gt;• sau pha 1: broadcast L₁ (&lt;i&gt;Global_FreqItemset&lt;/i&gt;), bỏ item không phổ biến, bỏ giỏ &amp;lt; 2 món → cache &lt;b&gt;t′&lt;/b&gt;&lt;br&gt;• sau mỗi bậc: giữ item thuộc Lₖ, bỏ giỏ &amp;lt; k+1 món → cache &lt;b&gt;t″&lt;/b&gt;, bỏ cache cũ&lt;br&gt;• dữ liệu cache &lt;b&gt;nhỏ dần&lt;/b&gt; → bài báo đo được bộ nhớ thấp nhất" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="760" y="510" width="680" height="120" as="geometry"/></mxCell><mxCell id="d2_c25" value="idx đã xếp theo tần suất giảm dần (DE), nên giữ idx tăng dần chính là “sắp theo support” của bài báo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=2;fontColor=#545B64;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="640" width="680" height="40" as="geometry"/></mxCell><mxCell id="d2_c26" value="Sinh luật (mục 4 bài báo) và FP-Growth" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=#0194E2;" vertex="1" parent="1"><mxGeometry x="1500" y="110" width="660" height="36" as="geometry"/></mxCell><mxCell id="d2_c27" value="&lt;b&gt;gen_rules&lt;/b&gt;&lt;br&gt;• broadcast &lt;b&gt;freq&lt;/b&gt;: tập → count&lt;br&gt;• flatMap mỗi tập S (|S| ≥ 2) → mọi X → Y = S \ X&lt;br&gt;• conf = f(S)/f(X); lift = conf / supp(Y)&lt;br&gt;• mỗi luật sinh đúng 1 lần, không cần reduce gom trùng" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6F4FC;strokeColor=#0194E2;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1500" y="170" width="660" height="150" as="geometry"/></mxCell><mxCell id="d2_c28" value="&lt;b&gt;FP-Growth&lt;/b&gt; (pyspark.ml.fpm, Parallel FP-Growth)&lt;br&gt;• cùng min_count = ceil(MinSupp × N)&lt;br&gt;• không có max_k: so kết quả thì lọc size ≤ max_k&lt;br&gt;• associationRules chỉ có &lt;b&gt;vế phải 1 item&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEEE6;strokeColor=#E25A1C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1500" y="350" width="660" height="130" as="geometry"/></mxCell><mxCell id="d2_c29" value="&lt;b&gt;Kiểm tra đúng đắn (E1)&lt;/b&gt;&lt;br&gt;DApriori = DATID = đếm vét cạn = FP-Growth (lọc ≤ max_k)&lt;br&gt;luật 1 vế phải của gen_rules = MLlib → &lt;b&gt;MLlib FP-Growth là exhaustive&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1500" y="510" width="660" height="120" as="geometry"/></mxCell><mxCell id="d2_c30" value="Vì sao giới hạn k ở cấp product" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=#545B64;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="2120" height="36" as="geometry"/></mxCell><mxCell id="d2_c31" value="&lt;b&gt;department&lt;/b&gt;: 21 item · giỏ dày&lt;br&gt;→ exhaustive, giống Poker (78 item) trong bài" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="690" height="80" as="geometry"/></mxCell><mxCell id="d2_c32" value="&lt;b&gt;aisle&lt;/b&gt;: 134 item&lt;br&gt;→ exhaustive, giống Otto (93 item) trong bài" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="755" y="780" width="690" height="80" as="geometry"/></mxCell><mxCell id="d2_c33" value="&lt;b&gt;product&lt;/b&gt;: ~49.7 nghìn item, giỏ dài tới ~145 món&lt;br&gt;→ C(145,3) ≈ 500 nghìn bộ ba / giỏ → &lt;b&gt;k ≤ 3&lt;/b&gt;, MinSupp ≥ 0,001" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#FF3621;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1470" y="780" width="690" height="80" as="geometry"/></mxCell><mxCell id="d2_c34" value="Bài báo: thời gian tăng theo hàm mũ khi số item tăng (Otto, Hình 12). Giới hạn k là điều chỉnh của nhóm, phải giải thích trong báo cáo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=2;fontColor=#545B64;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="2120" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d3" name="Hadoop local"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1000" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d3_c1" value="Cụm Hadoop local bằng Docker: MapReduce và Spark dùng chung HDFS + YARN" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2100" height="34" as="geometry"/></mxCell><mxCell id="d3_c2" value="So sánh công bằng: cùng máy, cùng file trên HDFS, cùng bộ cấp tài nguyên YARN, cùng số luồng n, cùng split 8 MB." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#545B64;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2100" height="24" as="geometry"/></mxCell><mxCell id="d3_c3" value="&lt;b&gt;ADLS&lt;/b&gt; ds-data/exports/v1/product/scale=*/&lt;br&gt;+ _manifest.json" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0078D4;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="330" height="64" as="geometry"/></mxCell><mxCell id="d3_c4" value="&lt;b&gt;Máy host&lt;/b&gt;: data/ds/ (gitignore)&lt;br&gt;fetch_exports.sh (AzCopy)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="330" height="64" as="geometry"/></mxCell><mxCell id="d3_c5" value="az login" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3_c3" target="d3_c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3_c6" value="docker compose · image instacart-hadoop:3.3.6 (Hadoop 3.3.6 + Spark 3.5.3 + Python 3, Java 11)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2496ED;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;spacingBottom=12;fontSize=14;fontStyle=1;fontColor=#2496ED;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="1740" height="700" as="geometry"/></mxCell><mxCell id="d3_c7" value="HDFS" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=#D9A400;" vertex="1" parent="1"><mxGeometry x="450" y="160" width="420" height="36" as="geometry"/></mxCell><mxCell id="d3_c8" value="&lt;b&gt;namenode&lt;/b&gt; :9870&lt;br&gt;metadata, block map" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#D9A400;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="450" y="210" width="420" height="56" as="geometry"/></mxCell><mxCell id="d3_c9" value="&lt;b&gt;datanode1&lt;/b&gt; · &lt;b&gt;datanode2&lt;/b&gt;&lt;br&gt;replication 2 · block 8 MB (dfs.blocksize lúc put)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#D9A400;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="450" y="286" width="420" height="56" as="geometry"/></mxCell><mxCell id="d3_c10" value="/ds/v1/product/scale=10 · 25 · 50 · 100&lt;br&gt;scale=200 = hai bản của 100% (sizeup)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A400;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="450" y="362" width="420" height="56" as="geometry"/></mxCell><mxCell id="d3_c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D9A400;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3_c8" target="d3_c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3_c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D9A400;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3_c9" target="d3_c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3_c13" value="YARN" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=#545B64;" vertex="1" parent="1"><mxGeometry x="920" y="160" width="420" height="36" as="geometry"/></mxCell><mxCell id="d3_c14" value="&lt;b&gt;resourcemanager&lt;/b&gt; :8088" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="920" y="210" width="420" height="44" as="geometry"/></mxCell><mxCell id="d3_c15" value="&lt;b&gt;nodemanager&lt;/b&gt;: 8 vcores · 12 GB&lt;br&gt;(limit Docker ≤ CPU cấp cho Docker Desktop)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="920" y="274" width="420" height="56" as="geometry"/></mxCell><mxCell id="d3_c16" value="&lt;b&gt;historyserver&lt;/b&gt; :19888 (counter MR)&lt;br&gt;&lt;b&gt;sparkhistory&lt;/b&gt; :18080 (executor metrics)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="920" y="350" width="420" height="56" as="geometry"/></mxCell><mxCell id="d3_c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3_c14" target="d3_c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3_c18" value="client · bench.py (E6)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=#2496ED;" vertex="1" parent="1"><mxGeometry x="1390" y="160" width="740" height="36" as="geometry"/></mxCell><mxCell id="d3_c19" value="&lt;b&gt;MapReduce (Java)&lt;/b&gt;&lt;br&gt;ItemCount → &lt;i&gt;ghi L₁ xuống HDFS&lt;/i&gt; → PairCount (distributed cache)&lt;br&gt;map.limit = reduce.limit = n · container 1,5 GB" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#D9A400;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1390" y="210" width="740" height="84" as="geometry"/></mxCell><mxCell id="d3_c20" value="&lt;b&gt;Spark on YARN&lt;/b&gt;&lt;br&gt;pair_count_df (chỉ JVM) · pair_count_rdd (Python)&lt;br&gt;--num-executors 1 --executor-cores n · 1,2 GB × n · L₁ giữ trong bộ nhớ" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEEE6;strokeColor=#E25A1C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1390" y="314" width="740" height="84" as="geometry"/></mxCell><mxCell id="d3_c21" value="Đo: wall_s · job_s (REST) · peak_mem (counter / peakMemoryMetrics) · &lt;b&gt;spill_mb&lt;/b&gt; (ghi đĩa trung gian)&lt;br&gt;Kiểm: cùng số cặp, cùng tổng count, bằng L₂ của DApriori trên Databricks" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#2496ED;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1390" y="418" width="740" height="70" as="geometry"/></mxCell><mxCell id="d3_c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2496ED;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3_c19" target="d3_c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3_c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2496ED;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3_c20" target="d3_c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3_c24" value="load_hdfs.sh (put -f)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3_c4" target="d3_c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="282"/><mxPoint x="400" y="390"/></Array></mxGeometry></mxCell><mxCell id="d3_c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#D9A400;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3_c10" target="d3_c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="379"/><mxPoint x="895" y="440"/><mxPoint x="1365" y="440"/><mxPoint x="1365" y="252"/></Array></mxGeometry></mxCell><mxCell id="d3_c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;end