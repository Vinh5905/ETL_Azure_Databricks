model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["DbxServer", "DbxHttpPath", "Catalog", "Schema", "dim_date", "dim_department", "product_360", "kpi_daily", "kpi_by_dow_hour", "department_sales", "product_pair_counts", "bi_user_access", "stream_kpi_1m", "fact_order_lines", "dim_aisle", "_Measures"]

ref table dim_date
ref table dim_department
ref table product_360
ref table kpi_daily
ref table kpi_by_dow_hour
ref table department_sales
ref table product_pair_counts
ref table bi_user_access
ref table stream_kpi_1m
ref table fact_order_lines
ref table dim_aisle
ref table _Measures

ref cultureInfo en-US
