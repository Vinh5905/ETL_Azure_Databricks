expression DbxServer = "(sample)" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	annotation PBI_ResultType = Text

expression DbxHttpPath = "" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	annotation PBI_ResultType = Text

expression Catalog = "instacart" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	annotation PBI_ResultType = Text

expression Schema = "gold" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	annotation PBI_ResultType = Text

expression GetDatabricksTable =
		(schemaName as text, tableName as text) as table =>
		let
		    Databases = Databricks.Catalogs(DbxServer, DbxHttpPath, [Catalog=Catalog]),
		    Data = Databases{[Name=Catalog, Kind="Database"]}[Data],
		    Tables = Data{[Name=schemaName, Kind="Schema"]}[Data]
		 in
		    Tables{[Name=tableName]}[Data]
	annotation PBI_ResultType = Function

