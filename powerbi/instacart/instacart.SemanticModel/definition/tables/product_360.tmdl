			    Sample = Table.PromoteHeaders(Csv.Document(Text.ToBinary(SampleCsv[product_360]), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
			    Source = if DbxServer = "(sample)" then Sample else GetDatabricksTable(Schema, "product_360"),
			    Typed = Table.TransformColumnTypes(Source, {{"product_id", Int64.Type}, {"product_name", type text}, {"aisle_id", Int64.Type}, {"aisle", type text}, {"department_id", Int64.Type}, {"department", type text}, {"current_price", Currency.Type}, {"on_promotion", type logical}, {"discount_pct", type number}, {"brand", type text}, {"nutriscore_grade", type text}, {"nova_group", Int64.Type}, {"energy_kcal_100g", type number}, {"sugars_100g", type number}, {"image_url", type text}, {"off_match_status", type text}, {"off_match_score", type number}, {"times_ordered", Int64.Type}, {"reorder_rate", type number}, {"revenue_sim", Currency.Type}, {"n", Int64.Type}}, "en-US")
