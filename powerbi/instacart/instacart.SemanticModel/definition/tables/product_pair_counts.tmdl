table product_pair_counts

	column p1
		dataType: int64
		sourceColumn: p1
		summarizeBy: none
		isHidden

	column p2
		dataType: int64
		sourceColumn: p2
		summarizeBy: none
		isHidden

	column pair_count
		dataType: int64
		sourceColumn: pair_count
		summarizeBy: none

	column support
		dataType: double
		sourceColumn: support
		summarizeBy: none

	column confidence_p1_to_p2
		dataType: double
		sourceColumn: confidence_p1_to_p2
		summarizeBy: none

	column lift
		dataType: double
		sourceColumn: lift
		summarizeBy: none

	partition product_pair_counts = m
		mode: import
		source =
			let
			    Sample = Table.PromoteHeaders(Csv.Document(Text.ToBinary(SampleCsv[product_pair_counts]), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
			    Source = if DbxServer = "(sample)" then Sample else GetDatabricksTable(Schema, "product_pair_counts"),
			    Typed = Table.TransformColumnTypes(Source, {{"p1", Int64.Type}, {"p2", Int64.Type}, {"pair_count", Int64.Type}, {"support", type number}, {"confidence_p1_to_p2", type number}, {"lift", type number}}, "en-US")
			 in
			    Typed
